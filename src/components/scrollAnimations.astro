---
import FigureColumn from "./FigureColumn.astro";

const col1 = [
    "/img/17.webp", "/img/18.webp", "/img/19.webp", "/img/20.webp", "/img/21.webp",
    "/img/1.webp", "/img/37.webp", "/img/38.webp", "/img/4.webp", "/img/7.webp",
    "/img/41.webp", "/img/20.webp"
];
const col2 = [
    "/img/22.webp", "/img/23.webp", "/img/24.webp", "/img/25.webp", "/img/26.webp",
    "/img/6.webp", "/img/16.webp", "/img/39.webp", "/img/9.webp", "/img/40.webp",
    "/img/42.webp", "/img/45.webp"
];
const col3 = [
    "/img/27.webp", "/img/28.webp", "/img/29.webp", "/img/30.webp", "/img/31.webp",
    "/img/32.webp", "/img/33.webp", "/img/34.webp", "/img/35.webp", "/img/36.webp",
    "/img/43.webp", "/img/44.webp"
];

const columns = [col1, col2, col3];
---
<div class="container mx-auto">

    <h1 class="xl:px-24 px-2 xl:text-4xl text-white xl:pt-10 pt-2 xl:pb-8 pb-2 font-bold">PORTFOLIO</h1>

    <div class="columns text-white xl:gap-4 gap-1 xl:px-24 px-1">
        {columns.map((col, index) => (
            <div class={`column xl:gap-4 gap-1 ${index % 2 === 0 ? 'column-reverse' : ''}`}>
                {col.map((url) => (
                    <FigureColumn
                        url={url}
                        title={`Foto ${url.split('/').pop().split('.')[0]}`}
                    />
                ))}
            </div>
        ))}
    </div>
</div>

<style>
    /* Base styles (Mobile first) */
    .columns {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .column {
        display: flex;
        flex-direction: column;
    }

    /* Desktop / Large screens configuration */
    @media (min-width: 1024px) {
        /* Three column layout */
        .columns {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            overflow-y: hidden;
        }

        /* Shift entire column up, but not so much that it goes out of view */
        .column-reverse {
            transform: translateY(calc(-100% + 100vh));
            flex-direction: column-reverse;
        }

        /* Set up Animation */
        @keyframes adjust-position {
            /* Start position: shift entire column up */
            from {
                transform: translateY(calc(-100% + 100vh));
            }

            /* End position: shift entire column down */
            to {
                transform: translateY(calc(100% - 100vh));
            }
        }

        /* Hook our animation with the timeline to our columns */
        .column-reverse {
            animation: adjust-position linear forwards;
            animation-timeline: scroll(root block);
        }
    }
</style>

<script>
    // Only run animation logic on large screens where the layout supports it
    if (window.matchMedia("(min-width: 1024px)").matches) {
        const columnsContainer = document.querySelector(".columns");

        if (columnsContainer) {
            // As we're about to shift content out of .columns, we need it to hide its overflow
            columnsContainer.style.overflowY = "hidden";

            // Check if ScrollTimeline is supported before using it
            if (typeof ScrollTimeline !== 'undefined') {
                const timeline = new ScrollTimeline({
                    source: document.documentElement,
                });

                // Loop all eligible columns
                document.querySelectorAll(".column-reverse").forEach(($column) => {
                    // Flip item order in reverse columns
                    $column.style.flexDirection = "column-reverse";

                    // Hook Animation
                    $column.animate(
                        {
                            transform: [
                                "translateY(calc(-100% + 100vh))",
                                "translateY(calc(100% - 100vh))"
                            ]
                        },
                        {
                            fill: "both",
                            timeline
                        }
                    );
                });
            }
        }
    }
</script>