---
import FigureColumn from "./FigureColumn.astro";

const col1 = [
    "/img/17.webp", "/img/18.webp", "/img/19.webp", "/img/20.webp", "/img/21.webp",
    "/img/1.webp", "/img/37.webp", "/img/38.webp", "/img/4.webp", "/img/7.webp",
    "/img/41.webp", "/img/20.webp"
];
const col2 = [
    "/img/22.webp", "/img/23.webp", "/img/24.webp", "/img/25.webp", "/img/26.webp",
    "/img/27.webp", "/img/16.webp", "/img/39.webp", "/img/9.webp", "/img/40.webp",
    "/img/42.webp", "/img/45.webp"
];
const col3 = [
    "/img/6.webp", "/img/28.webp", "/img/29.webp", "/img/30.webp", "/img/31.webp",
    "/img/32.webp", "/img/33.webp", "/img/34.webp", "/img/35.webp", "/img/36.webp",
    "/img/43.webp", "/img/44.webp"
];

const columns = [col1, col2, col3];
---
<div class="container mx-auto px-4 py-24 max-w-[1400px]">

    <h1 class="text-center text-5xl md:text-7xl font-semibold tracking-tighter text-white mb-24 opacity-90">
        Portfolio.
    </h1>

    <div class="columns-wrapper relative">
        <!-- Degradados superior e inferior para suavizar la entrada/salida de las imágenes -->
        <div class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-black via-black/80 to-transparent z-10"></div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-black via-black/80 to-transparent z-10"></div>

        <div class="columns grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-12">
            {columns.map((col, index) => (
                <div class={`column flex flex-col gap-8 lg:gap-12 ${index % 2 !== 0 ? 'column-reverse' : ''}`}>
                    {col.map((url) => (
                        <FigureColumn
                            url={url}
                            title={`Foto ${url.split('/').pop().split('.')[0]}`}
                        />
                    ))}
                </div>
            ))}
        </div>
    </div>
</div>

<style>
    /* Estilos base para la animación de scroll */
    .columns-wrapper {
        overflow: hidden;
        /* Altura mínima para asegurar que el scroll funcione bien */
        min-height: 100vh;
    }

    /* Configuración solo para escritorio */
    @media (min-width: 1024px) {
        /* La columna central se mueve en dirección opuesta (hacia arriba) al hacer scroll hacia abajo */
        .column-reverse {
            transform: translateY(0); /* Punto inicial */
        }

        /* Definimos la animación vinculada al scroll */
        @keyframes scroll-up {
            from { transform: translateY(10%); }
            to { transform: translateY(-40%); }
        }

        @keyframes scroll-down {
            from { transform: translateY(-40%); }
            to { transform: translateY(10%); }
        }

        /* Aplicamos las animaciones */
        .column:not(.column-reverse) {
            animation: scroll-up linear;
            animation-timeline: scroll(root block);
        }

        .column-reverse {
            animation: scroll-down linear;
            animation-timeline: scroll(root block);
        }
    }
</style>

<script>
    // Fallback para navegadores que no soporten CSS Scroll Timeline nativo
    if (window.matchMedia("(min-width: 1024px)").matches) {
        // Verificamos soporte de CSS puro, si no, usamos JS (opcional, pero recomendado para compatibilidad)
        const isScrollTimelineSupported = CSS.supports("animation-timeline: scroll()");

        if (!isScrollTimelineSupported) {
            console.log("CSS Scroll Timeline no soportado, activando fallback JS...");
            // Aquí podrías añadir un fallback con IntersectionObserver o evento scroll si fuera crítico
            // Por ahora, el diseño degradará elegantemente a columnas estáticas.
        }
    }
</script>