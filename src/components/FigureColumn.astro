---
interface Props {
    title?: string;
    url: string
    year?: string
}
const {title, url, year} = Astro.props;
---
<figure class="group relative mb-6 break-inside-avoid">
    <div class="overflow-hidden rounded-2xl bg-gray-900 shadow-sm transition-all duration-500 group-hover:shadow-2xl">
        <img
            loading="lazy"
            class="w-full h-auto opacity-0 transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] group-hover:scale-105 will-change-transform"
            src={url}
            alt={title}
            title={title}
            onload="this.classList.remove('opacity-0')"
        />
        <!-- Overlay sutil para dar profundidad al hover -->
        <div class="absolute inset-0 bg-black/0 transition-colors duration-500 group-hover:bg-black/5 pointer-events-none"></div>
    </div>

    <figcaption class="mt-3 flex justify-between px-2 text-xs font-medium tracking-wide text-gray-500 opacity-0 transition-all duration-500 group-hover:opacity-100 group-hover:translate-y-0 translate-y-2">
        <span class="uppercase tracking-wider">{title}</span>
        <span>{year}</span>
    </figcaption>
</figure>
