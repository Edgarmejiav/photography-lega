---
interface Props {
    title?: string;
    url: string
    year?: string
}
const {title, url, year} = Astro.props;
---
<figure class="overflow-hidden ">
    <img class="animate-fade-in transition duration-500 transform scale-100 hover:scale-125" src={url} alt={title} title={title} height="" width="">

    <figcaption class="text-center ">
        <span>{title}</span> <span>{year}</span>
    </figcaption>
</figure>
